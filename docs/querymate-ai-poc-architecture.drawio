        <mxCell id="noteLlm" value="&lt;b&gt;LLM has no direct access to DAB, MCP tools, SQL Server, websites, or internal APIs.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Tool execution is controlled by the application.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#b71c1c;strokeWidth=2;dashed=1;dashPattern=4 4;" vertex="1" parent="1"><mxGeometry x="1195" y="465" width="300" height="110" as="geometry" /></mxCell>

