        <mxCell id="title" value="QueryMate AI - POC Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="720" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Application-controlled LLM orchestration with secure MCP boundary and read-only data access" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="72" width="760" height="24" as="geometry" /></mxCell>

