        <mxCell id="controller" value="&lt;b&gt;ChatController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#33691e&quot;&gt;Request validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#82b366;fontSize=17;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="325" y="565" width="360" height="58" as="geometry" /></mxCell>
        <mxCell id="coord" value="&lt;b&gt;ChatCoordinator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#33691e&quot;&gt;Controls chat turn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#82b366;fontSize=17;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="325" y="650" width="360" height="58" as="geometry" /></mxCell>
