        <mxCell id="llm" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#7f6000&quot;&gt;Primary: gpt-4.1-mini&lt;br&gt;Fallback: gpt-4.1-nano&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="535" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="noteLlm" value="&lt;b&gt;LLM has no direct access to DAB, MCP tools, SQL Server, websites, or internal APIs.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Tool execution is controlled by the application.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=13;fontColor=#b71c1c;strokeWidth=2;dashed=1;dashPattern=4 4;" vertex="1" parent="1"><mxGeometry x="820" y="690" width="320" height="116" as="geometry" /></mxCell>

