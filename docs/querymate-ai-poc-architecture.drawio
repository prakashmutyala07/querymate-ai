<mxfile host="app.diagrams.net" agent="querymate-ai-poc" version="24.7.17" type="device">
  <diagram id="querymate-ai-poc-architecture" name="QueryMate AI POC Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="QueryMate AI - POC Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="620" height="36" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Application-controlled LLM orchestration with secure MCP boundary and read-only data access" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="760" height="24" as="geometry" /></mxCell>

        <mxCell id="futureAuth" value="&lt;b&gt;Authentication / OIDC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Future capability outside current POC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#8a8f98;dashed=1;dashPattern=7 5;fontSize=14;fontColor=#5b6472;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="48" width="260" height="72" as="geometry" /></mxCell>

        <mxCell id="bandUser" value="User Experience" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#3f5f91;" vertex="1" parent="1"><mxGeometry x="130" y="145" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="user" value="&lt;b&gt;Business User&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b7cba;fontSize=18;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="190" width="240" height="74" as="geometry" /></mxCell>
        <mxCell id="ui" value="&lt;b&gt;Chat UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#475569&quot;&gt;Natural-language questions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b7cba;fontSize=18;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="320" width="240" height="74" as="geometry" /></mxCell>

        <mxCell id="app" value="&lt;b&gt;QueryMate AI Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#33691e&quot;&gt;Request validation&lt;br&gt;PII masking and rehydration&lt;br&gt;Application-controlled LLM orchestration&lt;br&gt;Secure MCP tool boundary&lt;br&gt;Structured response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e7d32;strokeWidth=3;fontSize=18;fontColor=#1b5e20;arcSize=4;" vertex="1" parent="1"><mxGeometry x="110" y="455" width="520" height="205" as="geometry" /></mxCell>

        <mxCell id="bandModel" value="LLM Provider" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#7f6000;" vertex="1" parent="1"><mxGeometry x="720" y="415" width="310" height="24" as="geometry" /></mxCell>
        <mxCell id="llm" value="&lt;b&gt;OpenAI API currently&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#7f6000&quot;&gt;CA-GIP LLM-as-a-Service&lt;br&gt;planned for Phase 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="455" width="310" height="110" as="geometry" /></mxCell>
        <mxCell id="llmNote" value="&lt;b&gt;LLM has no direct access to DAB, MCP tools, SQL Server, websites, or internal APIs.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Tool execution is controlled by the application.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#b71c1c;strokeWidth=2;dashed=1;dashPattern=4 4;" vertex="1" parent="1"><mxGeometry x="710" y="600" width="330" height="86" as="geometry" /></mxCell>

        <mxCell id="bandData" value="Data Access" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0e5c61;" vertex="1" parent="1"><mxGeometry x="465" y="710" width="200" height="24" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;DAB MCP Tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0e5c61&quot;&gt;approved read operations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0f3;strokeColor=#0e8088;fontSize=18;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="755" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="dab" value="&lt;b&gt;Microsoft Data API Builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0e5c61&quot;&gt;controlled data API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0f3;strokeColor=#0e8088;fontSize=18;fontColor=#0f172a;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="755" width="270" height="76" as="geometry" /></mxCell>
        <mxCell id="sql" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0b4f6c&quot;&gt;Read-only access&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#cfe8f6;strokeColor=#10739e;fontSize=18;fontColor=#0f172a;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="760" width="230" height="118" as="geometry" /></mxCell>

        <mxCell id="e1" value="1 User asks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#334155;endArrow=block;endFill=1;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2 UI request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#334155;endArrow=block;endFill=1;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3 App protects request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#2e7d32;endArrow=none;endFill=0;fontSize=14;fontColor=#2e7d32;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="4 Masked prompt/context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#b7791f;endArrow=block;endFill=1;fontSize=14;fontColor=#7f6000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5 Response or tool request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#334155;endArrow=block;endFill=1;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="llm" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="6 Approved tool execution" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#2e7d32;endArrow=block;endFill=1;fontSize=14;fontColor=#2e7d32;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="704" /><mxPoint x="235" y="704" /></Array></mxGeometry></mxCell>
        <mxCell id="e7a" value="7 Read-only data access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#0e8088;endArrow=block;endFill=1;fontSize=14;fontColor=#0e5c61;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="dab"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#10739e;endArrow=block;endFill=1;" edge="1" parent="1" source="dab" target="sql"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="8 Protected tool result returns to application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#64748b;endArrow=block;endFill=1;fontSize=14;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="793" /><mxPoint x="60" y="610" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="9 Final answer shown to user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.6;strokeColor=#64748b;endArrow=block;endFill=1;fontSize=14;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="560" /><mxPoint x="60" y="227" /></Array></mxGeometry></mxCell>
      </root>
